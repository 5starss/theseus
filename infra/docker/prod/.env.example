CORE_POSTGRES_PORT=5432
CORE_POSTGRES_DB=theseus26
CORE_POSTGRES_USER=theseus26
CORE_POSTGRES_PASSWORD=

# Kafka on EC2 Docker
KAFKA_CLUSTER_ID=
KAFKA_EXTERNAL_HOST=example.com
SPRING_KAFKA_BOOTSTRAP_SERVERS=theseus-prod-kafka:29092
SPRING_KAFKA_CONSUMER_GROUP_ID=theseus-api-server-prod
KAFKA_CONSUMER_GROUP_ID=theseus-api-server-prod
CORE_KAFKA_BOOTSTRAP_SERVERS=theseus-prod-kafka:29092
CORE_KAFKA_CONSUMER_ENABLED=true
KAFKA_TOPIC_TOOL_GENERATION_REQUEST=theseus.tool-generation.request
KAFKA_TOPIC_TOOL_REGENERATION_REQUEST=theseus.tool-regeneration.request
