# Common
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul
ENV=prod
ALLOWED_ORIGINS=https://example.com
VITE_API_BASE_URL=https://example.com

# MySQL RDS
SPRING_DATASOURCE_URL=jdbc:mysql://rds-stg.ssafyapp.com:3306/theseus26?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=theseus26
SPRING_DATASOURCE_PASSWORD=

# Redis ElastiCache
SPRING_DATA_REDIS_HOST=redis-stg.ssafyapp.com
