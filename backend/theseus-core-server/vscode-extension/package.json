{
  "name": "theseus-vscode",
  "displayName": "Theseus",
  "description": "VSCode sidebar client for the Theseus agent core.",
  "version": "0.0.1",
  "publisher": "theseus",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:theseus.chatView",
    "onCommand:theseus.start",
    "onCommand:theseus.stop",
    "onCommand:theseus.showLogs",
    "onCommand:theseus.selectWorktree",
    "onCommand:theseus.moveToSecondarySidebar",
    "onCommand:theseus.moveToPanel",
    "onCommand:theseus.askSelected",
    "onCommand:theseus.explainProblem",
    "onCommand:theseus.fixProblem",
    "onCommand:theseus.explainSelected",
    "onCommand:theseus.inlineEdit"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Theseus",
      "properties": {
        "theseus.corePath": {
          "type": "string",
          "default": "",
          "description": "Path to the theseus-core-server directory (the folder that contains theseus_engine/). Supports ${workspaceFolder}, ${userHome}, and ${env:NAME}."
        },
        "theseus.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to start Theseus. Supports ${workspaceFolder}, ${userHome}, and ${env:NAME}."
        },
        "theseus.runtimeMode": {
          "type": "string",
          "enum": [
            "auto",
            "source-python",
            "bundled-runner"
          ],
          "default": "auto",
          "description": "Runtime startup mode. auto uses theseus.runnerPath when configured, otherwise the source Python runtime."
        },
        "theseus.runnerPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a packaged Theseus runner binary. Supports ${workspaceFolder}, ${userHome}, and ${env:NAME}. When set, the extension starts this binary instead of python -m theseus_engine.daemon."
        },
        "theseus.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Optional Theseus server URL. Empty means standalone mode."
        },
        "theseus.workspacePath": {
          "type": "string",
          "default": "",
          "description": "Working directory for the agent (your project root). Supports ${workspaceFolder}, ${userHome}, and ${env:NAME}. Defaults to the first VSCode workspace folder."
        },
        "theseus.readyTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 60,
          "description": "Maximum seconds to wait for Theseus RunnerReady during startup. Values are capped at 60 seconds."
        }
      }
    },
    "commands": [
      {
        "command": "theseus.start",
        "title": "Theseus: Start Agent"
      },
      {
        "command": "theseus.stop",
        "title": "Theseus: Stop Agent"
      },
      {
        "command": "theseus.showLogs",
        "title": "Theseus: Show Logs"
      },
      {
        "command": "theseus.selectWorktree",
        "title": "Theseus: Select Workspace (Worktree)"
      },
      {
        "command": "theseus.moveToSecondarySidebar",
        "title": "Theseus: Move to Secondary Side Bar"
      },
      {
        "command": "theseus.moveToPanel",
        "title": "Theseus: Move to Panel"
      },
      {
        "command": "theseus.askSelected",
        "title": "Ask Theseus"
      },
      {
        "command": "theseus.explainProblem",
        "title": "Theseus: Explain Problem"
      },
      {
        "command": "theseus.fixProblem",
        "title": "Theseus: Fix Problem"
      },
      {
        "command": "theseus.explainSelected",
        "title": "Theseus: Explain Selection"
      },
      {
        "command": "theseus.inlineEdit",
        "title": "Theseus: Inline Edit"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "theseus.askSelected",
          "when": "editorHasSelection",
          "group": "theseus@1"
        },
        {
          "command": "theseus.explainSelected",
          "when": "editorHasSelection",
          "group": "theseus@2"
        },
        {
          "command": "theseus.explainProblem",
          "when": "editorTextFocus",
          "group": "theseus@3"
        },
        {
          "command": "theseus.fixProblem",
          "when": "editorTextFocus",
          "group": "theseus@4"
        }
      ],
      "problems/item/context": [
        {
          "command": "theseus.explainProblem",
          "group": "theseus@1"
        },
        {
          "command": "theseus.fixProblem",
          "group": "theseus@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "theseus",
          "title": "Theseus",
          "icon": "resources/theseus.svg"
        }
      ]
    },
    "views": {
      "theseus": [
        {
          "id": "theseus.chatView",
          "type": "webview",
          "name": "Chat"
        }
      ]
    },
    "keybindings": [
      {
        "command": "theseus.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "verify:package-inputs": "node scripts/verify-package-inputs.mjs",
    "package:vsix": "npm run compile && npm run verify:package-inputs && npx @vscode/vsce package",
    "package:test": "npm run package:vsix && powershell -NoProfile -ExecutionPolicy Bypass -File ..\\scripts\\package-test-distribution.ps1",
    "package:local-source": "npm run package:vsix && powershell -NoProfile -ExecutionPolicy Bypass -File ..\\scripts\\package-local-extension-source.ps1",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "1.90.0",
    "typescript": "^5.4.5"
  }
}
