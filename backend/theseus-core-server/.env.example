# =======================================================
# 1. Model & Routing Configuration (Core)
# =======================================================
# THESEUS_MODEL 설정 가이드
#
# 1. 상용 클라우드 API 모델
#    - OpenAI    : "gpt-4o", "gpt-4-turbo", "o1-mini" 등
#    - Anthropic : "claude-3-5-sonnet-20241022", "claude-3-opus-20240229" 등
#    - Google    : "gemini-1.5-pro", "gemini-1.5-flash" 등
#    - DeepSeek  : "deepseek-chat", "deepseek-coder" 등
#
# 2. 로컬 모델 (Ollama, vLLM)
#    - Ollama 사용 시: "ollama/llama3.1", "ollama/qwen2.5" 등 ('ollama/' 접두사 사용 권장)
#    - vLLM  사용 시: "vllm/meta-llama/Llama-3.1-8B-Instruct" 등 ('vllm/' 접두사 사용 권장)
#
THESEUS_MODEL="gpt-4o"

# Smart Model Routing Settings
# THESEUS_MODEL_ROUTING: true (지능형 모델 라우팅 활성화) | false (기본 모델만 사용)
THESEUS_MODEL_ROUTING=false

# THESEUS_MODEL_FAST: 단순 작업용 모델 (예: gpt-4o-mini, gemini-1.5-flash 등)
THESEUS_MODEL_FAST="gpt-4o-mini"

# THESEUS_MODEL_REASONING: 고성능 추론용 모델 (예: gpt-4o, claude-3-5-sonnet, gemini-1.5-pro 등)
THESEUS_MODEL_REASONING="gpt-4o"


# =======================================================
# 2. API Keys
# (사용하실 모델의 공급자에 맞는 키만 입력하세요)
# =======================================================
OPENAI_API_KEY="sk-your-openai-api-key-here"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"
GEMINI_API_KEY="AIzaSy-your-gemini-api-key-here"
DEEPSEEK_API_KEY="sk-your-deepseek-api-key-here"


# =======================================================
# 3. App & Environment Settings
# =======================================================
APP_NAME=TheseusCoreServer
# Allowed values: dev | test | prod
ENV=dev
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# =======================================================
# 4. Auth Settings
# =======================================================
# AUTH_MODE: mock | spring
# Use spring for API Server integration.
# mock is allowed only in dev/test and must never be used in prod.
AUTH_MODE=spring
SPRING_BOOT_INTERNAL_URL=http://localhost:8080
SPRING_BOOT_AUTH_VERIFY_URL=http://localhost:8080/api/internal/auth/verify
SPRING_BOOT_PROJECT_PERMISSIONS_URL=http://localhost:8080/api/internal/project/permissions
SPRING_BOOT_INTERNAL_HISTORY_MESSAGES_URL=http://localhost:8080/api/internal/history/messages
SPRING_BOOT_REMOTE_WORKSPACE_CONFIG_URL=http://localhost:8080/api/internal/remote-workspaces/connection-config
SPRING_BOOT_INTERNAL_API_KEY=theseus-local-internal-api-key
AUTH_TIMEOUT_SECONDS=5
BILLING_OUTBOX_SCHEDULER_ENABLED=false
BILLING_OUTBOX_BATCH_SIZE=10
BILLING_OUTBOX_FLUSH_INTERVAL_SECONDS=30
CORE_KAFKA_CONSUMER_ENABLED=true
CORE_LEGACY_TOOL_GENERATION_CONSUMER_ENABLED=true
CORE_TOOL_PLAN_CONSUMER_ENABLED=false
CORE_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
CORE_KAFKA_CONSUMER_GROUP_ID=theseus-core-tool-generation
KAFKA_TOPIC_TOOL_GENERATION_REQUEST=theseus.tool-generation.request
KAFKA_TOPIC_TOOL_REGENERATION_REQUEST=theseus.tool-regeneration.request
KAFKA_TOPIC_TOOL_GENERATION_EVENT=theseus.tool-generation.event
CORE_KAFKA_TOOL_PLAN_CONSUMER_GROUP_ID=theseus-core-tool-plan
KAFKA_TOPIC_TOOL_PLAN_REQUEST=theseus.tool-plan.request
KAFKA_TOPIC_TOOL_PLAN_EVENT=theseus.tool-plan.event
# PLAN draft execution spec validation mode:
# strict = block unsafe command/API patterns
# warn   = keep warnings but do not fail PLAN draft
# off    = skip execution_spec validation entirely
# 운영 환경에서는 strict 권장. 개발/모델 튜닝 중 검증이 과하면 warn/off 사용.
CORE_TOOL_PLAN_EXECUTION_SPEC_VALIDATION_MODE=strict
# PLAN draft final JSON synthesis mode:
# auto = try structured JSON output, then fall back to the existing parser
# response_format = force OpenAI-compatible response_format json_schema request first
# vllm_structured_outputs = use vLLM extra_body.structured_outputs JSON request first
# strict = fail the PLAN draft if structured JSON output cannot be parsed
# off = use the existing prompt/code-block parser only
CORE_TOOL_PLAN_STRUCTURED_OUTPUT_MODE=auto
KAFKA_TOPIC_TOOL_BUILD_REQUEST=theseus.tool-build.request
KAFKA_TOPIC_TOOL_BUILD_EVENT=theseus.tool-build.event
CORE_TOOL_PLAN_MAX_AGENT_TURNS=30
# Assistant가 "하겠습니다/진행 중입니다"처럼 작업을 예고했지만 tool call 없이 멈춘 경우
# 같은 사용자 턴 안에서 자동으로 agent loop에 재진입하는 최대 횟수입니다.
THESEUS_AGENT_AUTO_CONTINUE_MAX=1
# Agent loop 재진입 판정 모드: heuristic | semantic | hybrid
# hybrid는 명확한 구조 신호는 즉시 처리하고, 애매한 종료/계속 판단만 semantic evaluator로 보강합니다.
THESEUS_AGENT_LOOP_DECISION_MODE=hybrid
THESEUS_AGENT_LOOP_SEMANTIC_TIMEOUT_SECONDS=4
# Engine 공통 custom tool repair loop 횟수 (CLI/TUI/Extension/Server 공통)
THESEUS_TOOL_REPAIR_MAX_ATTEMPTS=2
# Server ToolBuild 호환 alias. 새 로직은 THESEUS_TOOL_REPAIR_MAX_ATTEMPTS를 우선 사용합니다.
CORE_TOOL_BUILD_MAX_REPAIR_ATTEMPTS=2
CORE_TOOL_BUILD_RUN_TIMEOUT_SECONDS=180
CORE_RUN_LEASE_TTL_SECONDS=60
CORE_RUN_EVENT_REPUBLISH_BATCH_SIZE=50

# Sandbox / Docker Settings
# Generated-tool sandbox gate image. Core does not auto-build this image.
# Dockerfile.sandbox installs requirements-sandbox.txt and startup check verifies
# that file plus key generated-tool imports inside the image.
# After editing requirements-sandbox.txt, rebuild manually or in CI/CD:
# docker build -f Dockerfile.sandbox -t theseus-sandbox:py311-tools .
# Production compose keeps this build behind the sandbox-build profile so
# deploys do not rebuild the sandbox image unless explicitly requested.
# Then restart Core with this image tag.
SANDBOX_IMAGE=theseus-sandbox:py311-tools
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_CPU_QUOTA=50000
SANDBOX_CPU_PERIOD=100000
SANDBOX_KEEP_FAILED_CONTAINERS=false
SANDBOX_STARTUP_CHECK=true
SANDBOX_STARTUP_STRICT=false
SANDBOX_PULL_ON_STARTUP=false
# DOCKER_HOST=unix:///var/run/docker.sock
# Core 컨테이너가 host Docker daemon을 제어할 때는 두 경로를 같은 bind mount로 맞추세요.
# Host Python 실행에서는 비워두면 기존 임시 디렉터리를 사용합니다.
# Docker Core container users must make this host path writable by uid 999.
# Docker socket access also requires DOCKER_GID to match the socket group id.
# SANDBOX_HOST_TEMP_ROOT=/tmp/theseus-sandbox-shared
# SANDBOX_CONTAINER_TEMP_ROOT=/tmp/theseus-sandbox-shared

# Custom tool runtime artifacts.
# In prod Docker, THESEUS_CUSTOM_TOOLS_HOST_DIR is bind-mounted to
# THESEUS_PROJECT_CUSTOM_TOOLS_DIR inside the Core container.
# THESEUS_CUSTOM_TOOLS_DIR=/backend/theseus-core-server/theseus_engine/custom_tools
# THESEUS_PROJECT_CUSTOM_TOOLS_DIR=/backend/theseus-core-server/theseus_engine/custom_tools/projects
# THESEUS_CUSTOM_TOOLS_HOST_DIR=/opt/theseus/custom_tools


# =======================================================
# 5. Observability (LangSmith)
# =======================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your-langchain-api-key-here"
LANGCHAIN_PROJECT="theseus-core-test"


# =======================================================
# 6. Infrastructure & Storage (Database, RAG)
# =======================================================
# Database Settings (PostgreSQL + pgvector)
CORE_POSTGRES_HOST=localhost
CORE_POSTGRES_PORT=15432
CORE_POSTGRES_DB=theseus_core
CORE_POSTGRES_USER=root
CORE_POSTGRES_PASSWORD=root
CORE_POSTGRES_SCHEMA=public

# RAG & Embeddings Settings
# EMBEDDING_PROVIDER: local (sentence-transformers) | remote (openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DIMENSION=384
RAG_TOP_K=5
RAG_MIN_SCORE=0.5


# =======================================================
# 7. Theseus Engine Core Settings
# =======================================================

# --- Runtime Mode ---
# THESEUS_RUNTIME_MODE: standalone (CLI/TUI 로컬 실행) | server (Spring 백엔드 연동)
# 미설정 시 project_id + actor_user_id 존재 여부로 자동 감지
THESEUS_RUNTIME_MODE=standalone

# --- Tool Retrieval ---
# THESEUS_DYNAMIC_TOOL_RETRIEVAL: true (RAG 기반 도구 선택) | false (전체 레지스트리 사용)
THESEUS_DYNAMIC_TOOL_RETRIEVAL=false

# --- Hook & Security ---
# THESEUS_ENABLE_AGENT_HOOK: true (파일 작업 보안 감사 훅 활성화) | false
THESEUS_ENABLE_AGENT_HOOK=false
# 서버 /stream에서 bash/write_file/edit_file/local_write_report 같은 민감 도구를
# 사용자 승인 없이 자동 허용할지 여부입니다.
# reject: 기존처럼 승인 필요 도구를 fail-closed 차단
# allow: RBAC와 현재 mode tool visibility를 통과한 민감 도구를 서버에서 자동 승인
THESEUS_SERVER_SENSITIVE_TOOL_POLICY=reject

# --- Remote Workspace Local Report Output ---
# Remote Workspace 선택 시 remote_* 읽기 결과를 Core worktree의 보고서 파일로 저장할지 여부
THESEUS_REMOTE_LOCAL_REPORT_WRITE_ENABLED=true
# local_write_report 저장 루트. 반드시 Core worktree 내부 상대 경로로 유지하세요.
THESEUS_LOCAL_REPORT_ROOT=reports
# true이면 API Server resolver의 allowWriteExecution=false인 Remote Workspace도
# AGENT 모드에서 remote_write_file/remote_edit_file 파일 수정 도구를 노출합니다.
# remote_run_command는 계속 allowWriteExecution=true일 때만 노출됩니다.
THESEUS_REMOTE_WORKSPACE_FILE_WRITE_OVERRIDE=false

# THESEUS_USE_LLM_VALIDATOR: true (LLM 기반 실행 검증, 현재 Stub — regex 폴백) | false
# 실제 LLM 검증기 구현 전까지는 활성화해도 regex 검증으로 동작합니다
THESEUS_USE_LLM_VALIDATOR=false

# --- Data & Storage ---
# THESEUS_DATA_DIR: 에이전트 데이터 저장 경로 (tool_artifacts 등)
# 기본값: ~/.theseus/data
# Docker container default: /home/appuser/.theseus/data
# THESEUS_DATA_DIR="/path/to/custom/data"

# --- Debug Dump ---
# THESEUS_DEBUG_DUMP: true (LLM 요청/응답 페이로드 JSON 덤프 활성화) | false
# 디버깅 목적으로만 사용하세요. 시스템 프롬프트·대화 내용이 파일에 저장됩니다.
# 활성화 시 세션 스코프별 고정 JSON 파일을 덮어씁니다.
# 예: ~/.theseus/debug_dumps/project_1_chat_23/router_incoming_request.json
THESEUS_DEBUG_DUMP=false

# THESEUS_DEBUG_DUMP_DIR: 덤프 파일 저장 경로
# 기본값: ~/.theseus/debug_dumps
# THESEUS_DEBUG_DUMP_DIR="/path/to/debug/dumps"

# --- Custom Base URL ---
# 로컬 서버나 사내망/프록시 등 사용자가 직접 요청을 보낼 URL 주소
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OPENAI_BASE_URL="http://localhost:8000/v1"
# vLLM 사용 시 THESEUS_MODEL=vllm 만 지정해도 /v1/models에서 served model을 자동 탐색합니다.
# THESEUS_VLLM_AUTO_DISCOVER_MODEL=true
# 여러 모델을 serve할 때 우선 사용할 served model id를 지정하려면 아래 값을 설정하세요.
# THESEUS_VLLM_MODEL="default"


# =======================================================
# 8. Custom Tool Specific Configuration
# (개별 커스텀 툴 실행에 필요한 API 키나 설정값을 여기에 추가하세요)
# =======================================================
# 예: NAVER_CLIENT_ID="your-id"
# 예: SLACK_BOT_TOKEN="xoxb-your-token"

