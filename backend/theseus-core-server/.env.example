# App Settings
APP_NAME=TheseusCoreServer
ENV=dev

# Auth Settings
# AUTH_MODE: mock | spring
AUTH_MODE=mock
SPRING_BOOT_INTERNAL_URL=http://localhost:8080
SPRING_BOOT_AUTH_VERIFY_URL=http://localhost:8080/api/auth/verify
AUTH_TIMEOUT_SECONDS=5

# Database Settings (PostgreSQL + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=theseus_core
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_SCHEMA=public

# RAG & Embeddings Settings
# EMBEDDING_PROVIDER: local (sentence-transformers) | remote (openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DIMENSION=384
RAG_TOP_K=5
RAG_MIN_SCORE=0.5

# AI / Tools Settings (Future Use)
OPENAI_API_KEY=sk-...
LANGSMITH_API_KEY=ls__...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=theseus-core
