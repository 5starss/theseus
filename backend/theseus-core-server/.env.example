# App Settings
APP_NAME=TheseusCoreServer
ENV=dev

# Auth Settings
# AUTH_MODE: mock | spring
AUTH_MODE=mock
SPRING_BOOT_INTERNAL_URL=http://localhost:8080
SPRING_BOOT_AUTH_VERIFY_URL=http://localhost:8080/api/internal/auth/verify
SPRING_BOOT_PROJECT_PERMISSIONS_URL=http://localhost:8080/api/internal/project/permissions
SPRING_BOOT_INTERNAL_HISTORY_MESSAGES_URL=http://localhost:8080/api/internal/history/messages
SPRING_BOOT_INTERNAL_API_KEY=theseus-local-internal-api-key
AUTH_TIMEOUT_SECONDS=5

# =======================================================
# LangSmith Configuration
# =======================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your-langchain-api-key-here"
LANGCHAIN_PROJECT="theseus-core-test"

# =======================================================
# LLM Provider Configuration
# =======================================================
# OPENHARNESS_MODEL 설정 가이드
# 
# 1. 상용 클라우드 API 모델
#    - OpenAI: "gpt-4o", "gpt-4-turbo", "o1-mini" 등
#    - Anthropic: "claude-3-5-sonnet-20241022", "claude-3-opus-20240229" 등
#    - Google Gemini: "gemini-1.5-pro", "gemini-1.5-flash" 등
#    - DeepSeek: "deepseek-chat", "deepseek-coder" 등
# 
# 2. 로컬 모델 (Ollama, vLLM)
#    - Ollama 사용 시: "ollama/llama3.1", "ollama/qwen2.5" 등 ('ollama/' 접두사 사용 권장)
#    - vLLM 사용 시: "vllm/meta-llama/Llama-3.1-8B-Instruct" 등 ('vllm/' 접두사 사용 권장)
# 
OPENHARNESS_MODEL="gpt-4o"

# =======================================================
# API Keys 
# (사용하실 모델의 공급자에 맞는 키만 주석을 해제하고 입력하세요)
# =======================================================

# 1. OpenAI
# OPENAI_API_KEY="sk-your-openai-api-key-here"

# 2. Anthropic (Claude)
# ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"

# 3. Google Gemini
# GEMINI_API_KEY="AIzaSy-your-gemini-api-key-here"

# 4. DeepSeek
# DEEPSEEK_API_KEY="sk-your-deepseek-api-key-here"

# =======================================================
# Custom Base URL Configuration
# (로컬 서버나 사내망/프록시 등 사용자가 직접 요청을 보낼 URL 주소를 변경할 때 사용)
# =======================================================

# Ollama를 다른 포트나 호스트에서 실행 중일 경우 (기본값: http://localhost:11434/v1)
# OLLAMA_BASE_URL="http://localhost:11434/v1"

# vLLM이나 기타 OpenAI 호환 (OpenRouter 등) 로컬/프록시 서버 엔드포인트
# OPENAI_BASE_URL="http://localhost:8000/v1"


# Database Settings (PostgreSQL + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=theseus_core
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_SCHEMA=public

# RAG & Embeddings Settings
# EMBEDDING_PROVIDER: local (sentence-transformers) | remote (openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DIMENSION=384
RAG_TOP_K=5
RAG_MIN_SCORE=0.5

# Theseus Engine Settings
# THESEUS_DYNAMIC_TOOL_RETRIEVAL: true (enable RAG-based tool selection) | false (use full registry)
THESEUS_DYNAMIC_TOOL_RETRIEVAL=true

# THESEUS_ENABLE_AGENT_HOOK: true (enable security auditor hook for file operations) | false
THESEUS_ENABLE_AGENT_HOOK=false
